<?xml version="1.0" encoding="utf-8"?>
<!-- Debug console: a root shell served by the daemon bootstrap forks. Styled
     like the app's other dialogs - rounded #1C1C1C card, grey accent, no
     purple - so it reads as a first-class screen rather than a stock alert. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/popup_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header: liveness dot + title + clear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/consoleStatusDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/console_status_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter"
            android:letterSpacing="0.06"
            android:text="@string/console_title"
            android:textColor="#FFE8E8E8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/consoleSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/console_subtitle_default"
            android:textColor="#FF6E6E6E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/consoleClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/console_chip_bg"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="@string/console_clear"
            android:textColor="#FFB0B0B0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Transcript -->
    <ScrollView
        android:id="@+id/consoleScroll"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/console_panel_bg"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/consoleOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textColor="#FFD0D0D0"
            android:textSize="11sp"
            tools:text="root console - commands run as uid 0&#10;&#10;$ id&#10;uid=0(root) gid=0(root)&#10;[rc=0]" />
    </ScrollView>

    <!-- Quick commands -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/consoleChipId"
                style="@style/DF_ConsoleChip"
                android:text="id" />

            <TextView
                android:id="@+id/consoleChipKsud"
                style="@style/DF_ConsoleChip"
                android:text="ksud late-load" />

            <TextView
                android:id="@+id/consoleChipLs"
                style="@style/DF_ConsoleChip"
                android:text="ls /data/adb" />

            <TextView
                android:id="@+id/consoleChipEnforce"
                style="@style/DF_ConsoleChip"
                android:text="getenforce" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Command entry -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/consoleInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/console_input_bg"
            android:fontFamily="monospace"
            android:hint="@string/console_hint"
            android:imeOptions="actionSend"
            android:inputType="textNoSuggestions"
            android:maxLines="3"
            android:minHeight="46dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="#FFE8E8E8"
            android:textColorHint="#FF6E6E6E"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/consoleSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/console_send_bg"
            android:contentDescription="@string/cd_run"
            android:scaleType="center"
            android:src="@drawable/ic_console_send" />
    </LinearLayout>

</LinearLayout>
